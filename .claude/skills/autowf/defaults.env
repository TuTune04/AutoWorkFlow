# Bộ agent của skill autowf cho Claude Code: Claude Opus viết plan, Codex code, Claude Sonnet review.
# Ghi đè từng biến trong .autowf.env của repo dự án (hoặc qua env). FALLBACK_CODER: viết code thay khi CODER chưa cài
# hoặc lỗi đăng nhập.
PLANNER=claude
PLAN_MODEL=claude-opus-5-5
CODER=codex
CODER_MODEL=
REVIEWER=claude
REVIEW_MODEL=claude-sonnet-5-5
FALLBACK_CODER=claude
